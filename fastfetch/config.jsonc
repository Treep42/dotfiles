{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "~/.config/fastfetch/squirtle.poke",
    "type": "file-raw",
    "padding": {
      "top": 1,
      "left": 1
    }
  },
  "display": {
      "separator": " ",
      "color": {
          "keys": "magenta"
      },
      "key": {
          "width": 4,
          "type": "icon"
      }
  },
  "modules": [
    "os",
    "kernel",
    "uptime",
    "wm",
    "packages",
    "terminal",
    "editor",
    "break",
    "board",
    "cpu",
    "gpu",
    "memory",
    {
        "type": "disk",
        "format": "({mountpoint}) {size-used} / {size-total} ({size-percentage})"
    },
    "break",
    "colors"
  ]
}
